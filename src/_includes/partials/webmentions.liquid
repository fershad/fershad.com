<div class="webmentions" id="webmentions">
  {% if mentions.likes.size > 0 %}
  <div class="likes ">
  <small>{{ mentions.likes | size }} Likes</small>
  </div>
  {% endif %}

  {% if mentions.reposts.size > 0 %}
  <div class="reposts">
  <small>{{ mentions.reposts | size }} Reposts</small>
  </div>
  {% endif %}

  {% if mentions.mentions.size > 0 %}
  <div class="mentions">
  <small>{{ mentions.mentions | size }} Mentions
  </small>
  </div>
  {% endif %}
</div>
