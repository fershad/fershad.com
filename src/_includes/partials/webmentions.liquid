<div class="webmentions" id="webmentions">
  {% if mentions.likes.size > 0 %}
  <small>{{ mentions.likes | size }} Likes{% if mentions.reposts.size > 0 or mentions.mentions.size > 0 %}, {% endif %}
  {% endif %}
  {% if mentions.reposts.size > 0 %}
  {{ mentions.reposts | size }} Reposts{% if mentions.mentions.size > 0 %}, {% endif %}
  {% endif %}
  {% if mentions.mentions.size > 0 %}
  {{ mentions.mentions | size }} Mentions
      {% endif %} since {{ date | date: "%b %d, %Y" }}</small>
</div>
