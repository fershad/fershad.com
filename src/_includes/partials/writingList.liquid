{% for post in postslist %}
{% assign thisPostMonth = post.data.published | date: "%B" %}
{% assign previousPostMonth = post.previous.data.published | date: "%B" %}

  {% assign tags = post.data.tags %}
  {% assign isNote = tags | find: "note" %}
  <li id={%- if thisPostMonth != previousPostMonth %}"{%- if isNote == "note" -%}notes-{%- else -%}posts-{%- endif -%}{{thisPostMonth}}"{% endif %}
      {%- if post.data.archived -%}{{"class=archived" | raw}}{%- endif -%}>
    <div class="post-title">
      <small class="post-type">
        <time class="postlist-date datetime="{{ post.data.published | date_to_rfc822 }}">
            <div class="jr-box no-tail">
            <span>{{ post.data.published | date_to_long_string | date: "%b" }}</span>
            <span class="current-year">{{ post.data.published | date_to_long_string | date: "%d" }}</span>
            </div>
        </time>
        {% if post.data.archived %}
          <strong>
            | Archived
          </strong>
        {% endif %}
      </small>
      <p class="title">
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </p>
    </div>
    {% unless post.data.archived %}
      {% if post.data.summary %}
        <p>{{ post.data.summary }}</p>
      {% endif %}
    {% else %}
      <p>
        This post is archived.
        {{ post.data.archiveNote }}</p>
    {% endunless %}
  </li>
{% endfor %}
