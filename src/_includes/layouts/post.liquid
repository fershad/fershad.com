---
layout: layouts/base.liquid
css: /css/post.css
---


{% assign date = published %}
{% assign year = date | date: '%Y' %}
{% assign currentYear = "now" | date: '%Y' %}
{% assign month = date | date: '%B' %}
{% assign day = date | date: '%d' %}
{% capture yearPath %}
{% if year == currentYear %}
/
{% else %}
/{{ year }}/
{% endif %}
{% endcapture %}
{% assign isNote = tags | find: "note" %}
{% capture type %}{% if isNote == 'note' %}notes{% else %}posts{% endif %}{% endcapture %}


{% unless isPage %}
{% unless date %}
  <aside class="banner outline callout"><p class="title">Draft Content</p>
  <p>
    The content on this page is a draft. It's not yet ready to be shared, so please don't.
  </p>
  <p>
    {% editLink page %} or <a href="/contact">contact me</a>.
  </p>
  </aside>
{% endunless %}
{% endunless %}

<article class="splitview h-entry">
<div class="pagetitle flow">
    {% if title %}
        {% unless isPage == true %}
        <div class="info">
              <nav aria-label="Breadcrumb" class="breadcrumb">
                <ol>
                  <li><small><a href="{{ yearPath }}">{{ date | date: '%Y' }}</a></small></li>
                  <li><small><a href="{{ yearPath }}#{{ type }}">{{type | capitalize }}</a></small></li>
                  <li><small><a href="{{ yearPath }}#{{ type }}-{{ month }}">{{ date | date: '%B' }}</a></small></li>
                </ol>
              </nav>
              {% assign mentions = webmentions.mentions | webmentionsByUrl: page.url %}
              {% if  mentions.mentionCount > 0 %}
                {% include 'partials/webmentions.liquid' %}
              {% endif %}
        </div>
        {% endunless %}
        <h1>
          <span class="p-name">{{ title }}</span>
        </h1>

        <nav role="navigation" class="toc">
            <details id="table-of-contents" class="table-of-contents" role="navigation" aria-label="Yearly Navigation">
                    <summary>Content</summary>
                    {{ content  | removeDeepLinks | toc }}
            </details>
        </nav>
        {% endif %}
</div>



  <section class="flow e-content post-body">
    {{ content }}

    {% unless isPage == true %}
        <aside class="banner outline callout">
          <p class="title">RSS</p>
          <p>Get more content like this by RSS. <a href="/feed.xml">Subscribe to the RSS feed</a></p>
        </aside>
    {% endunless %}
  </section>
</article>

<script>
const toc = document.querySelector('.table-of-contents');

function isTocOpen() {
    return toc.getAttribute('open') == '';
}

document.addEventListener('click', function(event) {
    if (isTocOpen()) {
        if (!toc.contains(event.target)) {
            toc.removeAttribute('open');
        }
    }
});
</script>
